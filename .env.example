# ==============================================================
#  ArmGuard – Mẫu cấu hình môi trường
#  Sao chép file này thành .env và điền giá trị thật
# ==============================================================

# ── Ứng dụng ──────────────────────────────────────────────────
APP_NAME=ArmGuard
APP_ENV=development          # development | production
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Backend ───────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# ── Cơ sở dữ liệu ─────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/armguard.db

# ── Model YOLO ────────────────────────────────────────────────
MODEL_PATH=models/best.pt
MODEL_CONFIDENCE=0.5         # Ngưỡng độ tin cậy (0–1)
MODEL_IOU=0.45
DEVICE=cpu                   # cpu | cuda | mps

# ── Lưu trữ ───────────────────────────────────────────────────
SNAPSHOT_DIR=data/snapshots
CLIP_DIR=data/clips
EXPORT_DIR=data/exports
LOG_DIR=data/logs
MAX_STORAGE_GB=50            # Tự dọn khi vượt ngưỡng
RETENTION_DAYS=30            # Xóa dữ liệu cũ hơn N ngày

# ── Telegram (tùy chọn) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Email / SMTP (tùy chọn) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Webhook (tùy chọn) ────────────────────────────────────────
WEBHOOK_URL=

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
